RISE_ENVIRONMENT=development
RISE_DATABASE_URL=sqlite:///./rise.db
RISE_ROUTING_MODE=fixture
RISE_ESCROW_MODE=local
RISE_RUN_WORKER=true
RISE_AUTO_CREATE_SCHEMA=true
RISE_JWT_SECRET=
RISE_WEBHOOK_SECRET=
RISE_DEMO_PASSWORD=
RISE_ALLOWED_ORIGINS=["http://localhost:3000","http://127.0.0.1:3000"]
RISE_ESCROW_JOURNAL_PATH=data/escrow.db
# Address lookup (operator-configured Photon-compatible service):
RISE_GEOCODING_SEARCH_URL=https://photon.komoot.io/api/
# Optional, operator-controlled model directory:
# RISE_MODEL_ARTIFACT_PATH=artifacts/models/main_v1
# Infrastructure environment (use Alembic; keep worker in a separate process):
# RISE_DATABASE_URL=postgresql+psycopg://rise:CHANGE_ME@127.0.0.1:5432/rise
# RISE_REDIS_URL=redis://127.0.0.1:6379/0
# RISE_ROUTING_MODE=osrm
# RISE_OSRM_CAR_URL=http://127.0.0.1:5000
